{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fluently",
  "version": "0.1.0",
  "identifier": "com.fluently.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @fluently/web dev -- --host 127.0.0.1",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @fluently/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fluently",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "resources/curriculum/manifest.json": "curriculum/manifest.json",
      "resources/curriculum/lessons/pre-a1-integrity-fixture.json": "curriculum/lessons/pre-a1-integrity-fixture.json"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
